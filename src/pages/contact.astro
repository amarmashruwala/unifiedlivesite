---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { content as c } from '../data/content';
---
<Layout><PageIntro title="Start a project." description="Tell us about your venue, event, communication challenge, or live experience. Start by shaping your project enquiry below."/>
<section class="section container contact-layout"><aside><h2>What would you<br/>like to connect?</h2><p>From a meeting room to a multi-venue broadcast, your objective is our starting point.</p><div class="contact-guidance"><h3>A useful starting point</h3><ul class="capability-list">{c.contact.guidance.map(g => <li>{g}</li>)}</ul></div><a class="text-link" href="/faq">Have a question? Explore FAQs ↗</a></aside>
<div class="form-panel"><div class="preview-notice" id="preview-notice"><span class="notice-label">Contact form preview</span><p>{c.contact.status}</p></div><noscript><p class="noscript-notice">JavaScript is needed to validate this preview. No information can be sent from this form.</p></noscript>
<form id="contact-form" novalidate aria-describedby="preview-notice" onsubmit="return false"><p class="form-legend">Fields marked <span aria-hidden="true">*</span> are required.</p><div class="form-grid">
<div class="field"><label for="name">Full name <span aria-hidden="true">*</span></label><input id="name" type="text" autocomplete="name" required aria-describedby="name-error"/><span class="field-error" id="name-error"></span></div>
<div class="field"><label for="organization">Organization <span class="optional">(optional)</span></label><input id="organization" type="text" autocomplete="organization"/></div>
<div class="field"><label for="email">Email address <span aria-hidden="true">*</span></label><input id="email" type="email" autocomplete="email" required aria-describedby="email-error"/><span class="field-error" id="email-error"></span></div>
<div class="field"><label for="phone">Phone number <span id="phone-requirement" class="optional">(optional)</span></label><input id="phone" type="tel" autocomplete="tel" aria-describedby="phone-error"/><span class="field-error" id="phone-error"></span></div>
<div class="field"><label for="country">Country or region <span class="optional">(optional)</span></label><input id="country" type="text" autocomplete="country-name"/></div>
<div class="field"><label for="industry">Industry <span class="optional">(optional)</span></label><select id="industry"><option value="">Select your industry</option>{c.industries.map(i => <option>{i.name}</option>)}<option>Other</option></select></div>
<div class="field"><label for="service">Service interest <span aria-hidden="true">*</span></label><select id="service" required aria-describedby="service-error"><option value="">Select a service</option>{c.contact.interests.map(s => <option>{s}</option>)}</select><span class="field-error" id="service-error"></span></div>
<div class="field"><label for="preferred">Preferred contact method</label><select id="preferred"><option value="email">Email</option><option value="phone">Phone</option></select></div>
<div class="field full-field"><label for="details">Project details <span aria-hidden="true">*</span></label><textarea id="details" rows="5" required aria-describedby="details-hint details-error" placeholder="Your objective, audience, locations, and any timing you have in mind…"></textarea><span class="field-hint" id="details-hint">Share a brief overview. Please leave out sensitive information.</span><span class="field-error" id="details-error"></span></div>
</div><div class="form-actions"><button type="button" class="button dark" id="validate-enquiry" disabled>Validate enquiry <span aria-hidden="true">↗</span></button><span>Preview only · No enquiry is sent</span></div><p id="form-status" role="status" aria-live="polite" tabindex="-1"></p></form></div></section>
<script>
const form = document.querySelector<HTMLFormElement>('#contact-form')!;
const button = document.querySelector<HTMLButtonElement>('#validate-enquiry')!;
const status = document.querySelector<HTMLParagraphElement>('#form-status')!;
const phone = document.querySelector<HTMLInputElement>('#phone')!;
const preference = document.querySelector<HTMLSelectElement>('#preferred')!;
button.disabled = false;
const params = new URLSearchParams(location.search);
for (const key of ['service','industry']) {
 const field = document.getElementById(key) as HTMLSelectElement;
 const value = params.get(key);
 if (value && [...field.options].some(o => o.value === value)) field.value = value;
}
function syncPhone() {
 phone.required = preference.value === 'phone';
 document.querySelector('#phone-requirement')!.textContent = phone.required ? '*' : '(optional)';
 if (!phone.required) { phone.removeAttribute('aria-invalid'); document.querySelector('#phone-error')!.textContent = ''; }
}
preference.addEventListener('change', syncPhone);
syncPhone();
form.addEventListener('submit', e => e.preventDefault());
form.addEventListener('input', () => { status.textContent = ''; });
button.addEventListener('click', () => {
 const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')];
 let firstInvalid: HTMLElement | undefined;
 for (const field of fields) {
  const error = document.getElementById(`${field.id}-error`);
  const missing = field.required && !field.value.trim();
  const invalid = missing || !field.validity.valid;
  if (error) error.textContent = missing ? 'Please complete this field.' : invalid ? 'Please enter a valid email address.' : '';
  if (invalid) { field.setAttribute('aria-invalid','true'); firstInvalid ??= field; } else field.removeAttribute('aria-invalid');
 }
 if (firstInvalid) { status.textContent = 'Please review the highlighted fields. Nothing has been sent.'; firstInvalid.focus(); }
 else { status.textContent = 'Your entries are valid. This is a preview: your enquiry has not been sent or stored. Contact delivery is not yet configured.'; status.focus(); }
});
</script>
</Layout>
