---
import '../styles/global.css';
import { content } from '../data/content';
import { routes } from '../data/routes';
import Logo from '../components/Logo.astro';
interface Props { title?: string; description?: string; noindex?: boolean; }
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const route = routes.find(r => r.path === path);
const { title = route?.title ?? 'UnifiedLive', description = route?.description ?? content.description, noindex = false } = Astro.props;
const isAI = path === '/ai';
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const schema = { '@context': 'https://schema.org', '@type': 'Organization', name: content.name, description: content.description, slogan: content.tagline, ...(Astro.site ? { url: Astro.site.href, logo: new URL('/logo.svg', Astro.site).href } : {}), location: content.locations.map(l => ({ '@type': 'Place', name: `${l.city}, ${l.country}` })) };
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#132522"/><title>{title}</title><meta name="description" content={description}/>{(noindex || !Astro.site) && <meta name="robots" content="noindex, nofollow"/>}{canonical && <link rel="canonical" href={canonical}/>}
<meta property="og:type" content="website"/><meta property="og:site_name" content="UnifiedLive"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:image" content={Astro.site ? new URL('/social.png', Astro.site).href : '/social.png'}/><meta property="og:image:alt" content={`UnifiedLive — ${content.tagline}`}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={Astro.site ? new URL('/social.png', Astro.site).href : '/social.png'}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="alternate" type="text/markdown" href="/ai-agent-content.md" title="UnifiedLive structured Markdown"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/><slot name="head"/></head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="header-inner"><Logo/>
<nav class="desktop-nav" aria-label="Primary">{routes.slice(1,7).map(r => <a href={r.path} aria-current={path === r.path ? 'page' : undefined}>{r.label}</a>)}</nav>
<div class="view-switch" aria-label="Website view"><a href="/" class:list={{active: !isAI}} aria-current={!isAI ? 'true' : undefined}>Human View</a><a href="/ai" class:list={{active: isAI}} aria-current={isAI ? 'page' : undefined}>AI Agent View</a></div>
<a href="/contact" class="header-cta">Start a Project <span aria-hidden="true">↗</span></a>
<details class="mobile-nav"><summary aria-label="Open navigation menu"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg><span>Menu</span></summary><nav aria-label="Mobile primary">{routes.slice(0,8).map(r => <a href={r.path} aria-current={path === r.path ? 'page' : undefined}>{r.label}</a>)}<a class="mobile-project" href="/contact">Start a Project ↗</a></nav></details>
</div></header>
<main id="main" tabindex="-1"><slot/></main>
<footer class="site-footer"><div class="container"><div class="footer-main"><div class="footer-brand"><Logo/><p>One partner.<br/>Every connection.</p><span class="footer-locations">Sydney · Mumbai</span></div><div><h2>Explore</h2><a href="/services">Services</a><a href="/industries">Industries</a><a href="/about">About us</a><a href="/faq">FAQs</a></div><div><h2>Connect</h2><a href="/global-presence">Global Presence</a><a href="/partnerships">Partnerships</a><a href="/contact">Talk to UnifiedLive ↗</a></div><div class="footer-ai"><h2>Built for connection.</h2><p>For people. And the agents<br/>helping them explore.</p><a href="/ai">AI Agent / Markdown Version <span aria-hidden="true">↗</span></a></div></div><div class="footer-signature" aria-hidden="true">unifiedlive.</div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} UnifiedLive</span><span>Strategy. Integration. Production. Connection.</span><a href="#main">Back to top ↑</a></div></div></footer>
<script>
 const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
 document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
 document.addEventListener('click', (event) => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
 const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
 if (!motion.matches && 'IntersectionObserver' in window) {
   const entrances = new IntersectionObserver(entries => {
     for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('arriving'); entrances.unobserve(entry.target); }
   }, { threshold: 0.12 });
   document.querySelectorAll('.chapter .section-heading, .chapter > .container > .connection-art, .approach-feature > div').forEach(element => entrances.observe(element));
   motion.addEventListener('change', () => { if (motion.matches) entrances.disconnect(); });
 }
</script>
</body></html>
